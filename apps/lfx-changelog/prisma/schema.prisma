generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ChangelogStatus {
  draft
  published
}

enum UserRole {
  super_admin
  product_admin
  editor
}

enum ApiKeyScope {
  changelogs_read
  changelogs_write
  products_read
  products_write
  blogs_read
  blogs_write
}

enum DeploymentType {
  standalone
  platform_subchart
}

enum ReleaseJobStatus {
  pending
  running
  succeeded
  failed
}

enum ChangelogSource {
  manual
  automated
}

enum AutoChangelogLockStatus {
  in_progress
  pending_rerun
}

enum ChatAccessLevel {
  public
  admin
}

enum AgentJobStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum AgentJobTrigger {
  webhook_push
  webhook_release
  webhook_pull_request
  manual
  newsletter_monthly
  newsletter_product
  newsletter_manual
}

enum BlogStatus {
  draft
  published
}

enum BlogType {
  monthly_roundup
  product_newsletter
}

enum ContributorSlackLinkSource {
  auto_email
  manual
}

model Product {
  id                    String   @id @default(uuid())
  name                  String   @unique
  slug                  String   @unique
  description           String?
  iconUrl               String?  @map("icon_url")
  faIcon                String?  @map("fa_icon")
  isActive              Boolean  @default(true) @map("is_active")
  githubInstallationId  Int?     @map("github_installation_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  changelogEntries    ChangelogEntry[]
  userRoleAssignments UserRoleAssignment[]
  repositories        ProductRepository[]
  autoChangelogLock   AutoChangelogLock?
  changelogViews      ChangelogView[]
  agentJobs           AgentJob[]
  agentMemory         AgentMemory?
  blogProducts        BlogProduct[]
  slackNotifyUsers    ProductSlackNotifyUser[]

  @@map("products")
}

model ProductRepository {
  id                    String   @id @default(uuid())
  productId             String   @map("product_id")
  githubInstallationId  Int      @map("github_installation_id")
  owner                 String
  name                  String
  fullName              String   @map("full_name")
  htmlUrl               String   @map("html_url")
  description           String?
  isPrivate             Boolean   @default(false) @map("is_private")
  lastSyncedAt          DateTime? @map("last_synced_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  product           Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  releases          GitHubRelease[]
  contributors      ContributorRepository[]
  releasableService ReleasableService?

  @@unique([productId, owner, name])
  @@index([productId])
  @@map("product_repositories")
}

/// A tracked repository that can be released to the LFX environments. Keyed on the repository
/// rather than a service name so the product link, owner/name and App installation come from the
/// row that already holds them, and product-scoped authorization applies unchanged.
model ReleasableService {
  id             String         @id @default(uuid())
  repositoryId   String         @unique @map("repository_id")
  displayName    String         @map("display_name")
  aliases        String[]       @default([])
  deploymentType DeploymentType @map("deployment_type")
  /// Argo CD application name. Null for platform_subchart, which has no application of its own.
  appName        String?        @map("app_name")
  /// Overrides the configured default GitOps repository when set.
  argocdRepo     String?        @map("argocd_repo")
  environments   String[]       @default(["staging", "prod"])
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  repository ProductRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  jobs       ReleaseJob[]

  @@map("releasable_services")
}

/// One attempt at releasing a service: the tag that was published and what the repository's CI
/// then did with it. Opened by the publish endpoint, which knows who asked, and by the release
/// webhook, which does not — so a tag pushed outside Changelog is tracked just the same.
model ReleaseJob {
  id                  String           @id @default(uuid())
  releasableServiceId String           @map("releasable_service_id")
  tagName             String           @map("tag_name")
  status              ReleaseJobStatus @default(pending)
  /// Who asked for the release in Changelog. Null for a tag pushed straight to GitHub, and for
  /// one published before this was recorded. GitHub credits the App rather than a person when
  /// Changelog publishes, so this is the only place the human behind it is known.
  requestedById       String?          @map("requested_by_id")

  /// Run ids exceed a 32-bit int and are only ever compared or interpolated into a URL, so they
  /// are stored as text rather than BigInt, which JSON cannot serialise. Not unique: a run is
  /// unique on GitHub, but a repository tracked by several products has a job per product and
  /// the one run reports to all of them.
  workflowRunId       String?          @map("workflow_run_id")
  workflowRunUrl      String?          @map("workflow_run_url")
  workflowName        String?          @map("workflow_name")
  conclusion          String?
  /// GitHub's own last-modified time for the run, which advances on every state change. Kept so
  /// that deliveries for one run can be ordered: a redelivery is older and must not undo the
  /// state it already reported, while a re-run reuses the id and is newer, so it may.
  runUpdatedAt        DateTime?        @map("run_updated_at")
  /// Per-job progress from workflow_job events, newest state per job name.
  steps               Json             @default("[]")

  startedAt           DateTime?        @map("started_at")
  completedAt         DateTime?        @map("completed_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  releasableService ReleasableService @relation(fields: [releasableServiceId], references: [id], onDelete: Cascade)
  requestedBy       User?             @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([releasableServiceId, tagName])
  @@index([releasableServiceId, createdAt])
  @@index([workflowRunId])
  @@map("release_jobs")
}

model GitHubRelease {
  id              String    @id @default(uuid())
  repositoryId    String    @map("repository_id")
  githubId        Int       @map("github_id")
  tagName         String    @map("tag_name")
  name            String?
  htmlUrl         String    @map("html_url")
  body            String?
  isDraft         Boolean   @default(false) @map("is_draft")
  isPrerelease    Boolean   @default(false) @map("is_prerelease")
  publishedAt     DateTime? @map("published_at")
  authorLogin     String    @map("author_login")
  authorAvatarUrl String    @map("author_avatar_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  repository ProductRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, githubId])
  @@index([publishedAt(sort: Desc)])
  @@map("github_releases")
}

model ChangelogEntry {
  id          String            @id @default(uuid())
  productId   String            @map("product_id")
  slug        String?           @unique
  title       String
  description String
  version     String?
  source      ChangelogSource   @default(manual) @map("source")
  status      ChangelogStatus   @default(draft)
  qualityScore Json?            @map("quality_score")
  publishedAt DateTime?         @map("published_at")
  createdBy   String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  product               Product                  @relation(fields: [productId], references: [id])
  author                User                     @relation(fields: [createdBy], references: [id])
  slackNotifications    SlackNotification[]
  agentJobs             AgentJob[]
  blogChangelogs    BlogChangelogEntry[]

  @@index([productId, status, publishedAt])
  @@map("changelog_entries")
}

model User {
  id        String   @id @default(uuid())
  auth0Id   String?  @unique @map("auth0_id")
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  changelogEntries    ChangelogEntry[]
  userRoleAssignments UserRoleAssignment[]
  apiKeys             ApiKey[]
  chatConversations   ChatConversation[]
  slackIntegrations   SlackIntegration[]
  blogs               Blog[]
  slackNotifyUsers    ProductSlackNotifyUser[]
  contributorsLinked  Contributor[]           @relation("ContributorSlackLinker")
  releaseJobs         ReleaseJob[]

  @@map("users")
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String?  @map("product_id")
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@unique([userId, productId, role])
  @@index([userId, productId])
  @@map("user_role_assignments")
}

model ApiKey {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  name       String
  keyPrefix  String        @map("key_prefix")
  keyHash    String        @unique @map("key_hash")
  scopes     ApiKeyScope[] @default([])
  expiresAt  DateTime      @map("expires_at")
  lastUsedAt DateTime?     @map("last_used_at")
  revokedAt  DateTime?     @map("revoked_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

model ChatConversation {
  id                 String          @id @default(uuid())
  userId             String?         @map("user_id")
  title              String          @default("New conversation")
  accessLevel        ChatAccessLevel @default(public) @map("access_level")
  sessionFingerprint String?         @map("session_fingerprint")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String?
  toolCalls      Json?    @map("tool_calls")
  toolCallId     String?  @map("tool_call_id")
  toolName       String?  @map("tool_name")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model SlackIntegration {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  teamId         String   @map("team_id")
  teamName       String   @map("team_name")
  slackUserId    String   @map("slack_user_id")
  accessToken    String   @map("access_token")
  refreshToken   String   @map("refresh_token")
  tokenExpiresAt DateTime @map("token_expires_at")
  scope          String
  status         String   @default("active")
  connectedAt    DateTime @default(now()) @map("connected_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channels SlackChannel[]

  @@unique([userId, teamId])
  @@map("slack_integrations")
}

model SlackChannel {
  id                 String   @id @default(uuid())
  slackIntegrationId String   @map("slack_integration_id")
  channelId          String   @map("channel_id")
  channelName        String   @map("channel_name")
  isDefault          Boolean  @default(false) @map("is_default")
  createdAt          DateTime @default(now()) @map("created_at")

  slackIntegration SlackIntegration  @relation(fields: [slackIntegrationId], references: [id], onDelete: Cascade)
  notifications    SlackNotification[]

  @@unique([slackIntegrationId, channelId])
  @@map("slack_channels")
}

model SlackNotification {
  id               String    @id @default(uuid())
  slackChannelId   String    @map("slack_channel_id")
  changelogEntryId String    @map("changelog_entry_id")
  messageTs        String?   @map("message_ts")
  status           String    @default("sent")
  errorMessage     String?   @map("error_message")
  sentAt           DateTime? @map("sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  slackChannel   SlackChannel   @relation(fields: [slackChannelId], references: [id], onDelete: Cascade)
  changelogEntry ChangelogEntry @relation(fields: [changelogEntryId], references: [id], onDelete: Cascade)

  @@unique([slackChannelId, changelogEntryId])
  @@map("slack_notifications")
}

model SlackBotInstallation {
  id             String   @id @default(uuid())
  teamId         String   @unique @map("team_id")
  teamName       String   @map("team_name")
  botUserId      String   @map("bot_user_id")
  accessToken    String   @map("access_token")
  refreshToken   String   @map("refresh_token")
  tokenExpiresAt DateTime @map("token_expires_at")
  scope          String
  status         String   @default("active")
  installedAt    DateTime @default(now()) @map("installed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("slack_bot_installations")
}

model ProductSlackNotifyUser {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("product_slack_notify_users")
}

model AutoChangelogLock {
  productId String                   @id @map("product_id")
  status    AutoChangelogLockStatus  @default(in_progress)
  lockedAt  DateTime                 @map("locked_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("auto_changelog_locks")
}

model ChangelogView {
  id           String   @id @default(uuid())
  viewerId     String   @map("viewer_id")
  productId    String   @map("product_id")
  lastViewedAt DateTime @default(now()) @map("last_viewed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([viewerId, productId])
  @@index([viewerId])
  @@map("changelog_views")
}

model AgentJob {
  id           String          @id @default(uuid())
  productId    String?         @map("product_id")
  trigger      AgentJobTrigger
  status       AgentJobStatus  @default(pending)
  changelogId  String?         @map("changelog_entry_id")
  promptTokens Int?            @map("prompt_tokens")
  outputTokens Int?            @map("output_tokens")
  durationMs   Int?            @map("duration_ms")
  numTurns     Int?            @map("num_turns")
  progressLog  Json            @default("[]") @map("progress_log")
  errorMessage String?         @map("error_message")
  createdAt    DateTime        @default(now()) @map("created_at")
  startedAt    DateTime?       @map("started_at")
  completedAt  DateTime?       @map("completed_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  blogId         String?         @map("blog_id")

  product        Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  changelogEntry ChangelogEntry? @relation(fields: [changelogId], references: [id], onDelete: SetNull)
  blog           Blog?           @relation(fields: [blogId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([createdAt])
  @@map("agent_jobs")
}

model AgentMemory {
  id        String   @id @default(uuid())
  productId String   @unique @map("product_id")
  memory    Json     @default("{}") @map("memory")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("agent_memories")
}

model Blog {
  id            String     @id @default(uuid())
  slug          String     @unique
  title         String
  excerpt       String?
  description   String
  type          BlogType   @default(monthly_roundup)
  status        BlogStatus @default(draft)
  coverImageUrl String?    @map("cover_image_url")
  publishedAt   DateTime?  @map("published_at")
  periodStart   DateTime?  @map("period_start")
  periodEnd     DateTime?  @map("period_end")
  createdBy     String     @map("created_by")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  author     User                 @relation(fields: [createdBy], references: [id])
  products   BlogProduct[]
  changelogs BlogChangelogEntry[]
  agentJobs  AgentJob[]

  @@unique([type, periodStart])
  @@index([status, publishedAt])
  @@map("blogs")
}

model BlogProduct {
  id        String @id @default(uuid())
  blogId    String @map("blog_id")
  productId String @map("product_id")

  blog    Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([blogId, productId])
  @@map("blog_products")
}

model BlogChangelogEntry {
  id               String @id @default(uuid())
  blogId           String @map("blog_id")
  changelogEntryId String @map("changelog_entry_id")

  blog           Blog           @relation(fields: [blogId], references: [id], onDelete: Cascade)
  changelogEntry ChangelogEntry @relation(fields: [changelogEntryId], references: [id], onDelete: Cascade)

  @@unique([blogId, changelogEntryId])
  @@map("blog_changelog_entries")
}

model Contributor {
  id              String   @id @default(uuid())
  githubUserId    Int      @unique @map("github_user_id")
  githubLogin     String   @map("github_login")
  githubAvatarUrl String?  @map("github_avatar_url")
  githubHtmlUrl   String?  @map("github_html_url")
  name            String?
  primaryEmail    String?  @map("primary_email")
  emails          String[] @default([])
  isBot           Boolean  @default(false) @map("is_bot")

  slackUserId      String?                     @unique @map("slack_user_id")
  slackTeamId      String?                     @map("slack_team_id")
  slackDisplayName String?                     @map("slack_display_name")
  slackRealName    String?                     @map("slack_real_name")
  slackAvatarUrl   String?                     @map("slack_avatar_url")
  slackLinkSource  ContributorSlackLinkSource? @map("slack_link_source")
  slackLinkedAt    DateTime?                   @map("slack_linked_at")
  slackLinkedById  String?                     @map("slack_linked_by_id")

  contributions Int       @default(0)
  firstSeenAt   DateTime  @default(now()) @map("first_seen_at")
  lastActiveAt  DateTime? @map("last_active_at")
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  slackLinkedBy User?                  @relation("ContributorSlackLinker", fields: [slackLinkedById], references: [id], onDelete: SetNull)
  repositories  ContributorRepository[]

  @@index([githubLogin])
  @@index([lastActiveAt(sort: Desc)])
  @@index([contributions(sort: Desc)])
  @@map("contributors")
}

model ContributorRepository {
  id            String    @id @default(uuid())
  contributorId String    @map("contributor_id")
  repositoryId  String    @map("repository_id")
  contributions Int       @default(0)
  lastActiveAt  DateTime? @map("last_active_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  contributor Contributor       @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  repository  ProductRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([contributorId, repositoryId])
  @@index([repositoryId])
  @@map("contributor_repositories")
}
